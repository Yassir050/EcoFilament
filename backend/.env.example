# Copy this file to .env for local configuration.
# Do not paste a real API key into this example file or commit .env to Git.

# Phase 2 will use this variable on the server only.
NVIDIA_API_KEY=your_new_nvidia_api_key_here

# Comma-separated allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://yassir050.github.io
